# The package holds the bundled extension, its manifest, README, CHANGELOG, LICENSE and icon. Everything else stays out:
# the source and tests (bundled into dist/), the plugin (Claude Code installs it from GitHub), and the tooling
**/*.ts
**/*.map
src/**
plugin/**
.claude-plugin/**
.github/**
.vscode/**
node_modules/**
images/*.svg
images/screenshot*
dist/*.vsix
.gitignore
.nvmrc
lefthook.yml
pnpm-lock.yaml
pnpm-workspace.yaml
tsconfig.json

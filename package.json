{
  "name": "claude-usage-bar",
  "displayName": "Usage Bar for Claude Code",
  "version": "0.0.0",
  "private": true,
  "description": "Your Claude Code 5-hour and weekly usage in the status bar. Reads no credentials, makes no network requests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arsw-dev/claude-usage-bar"
  },
  "publisher": "arsw",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:tooling"
  },
  "engines": {
    "node": ">=26",
    "vscode": "^1.140.0"
  },
  "packageManager": "pnpm@11.28.3"
}
